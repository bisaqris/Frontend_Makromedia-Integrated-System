NEXT_PUBLIC_API_URL="link-backend"

# Sumber data aplikasi (dipakai semua service di lib/services):
# - "1" atau tidak diset (default) -> pakai data di lib/mock (mode demo)
# - "0"                            -> pakai API asli lewat NEXT_PUBLIC_API_URL
# Satu saklar ini mengganti seluruh sumber data tanpa mengubah komponen/page.
NEXT_PUBLIC_USE_MOCK="1"

# Mock login (fallback + tombol demo) hanya aktif di development.
# Set "0" untuk mematikannya secara eksplisit; di production build selalu mati.
# NEXT_PUBLIC_ENABLE_MOCK_AUTH="1"
